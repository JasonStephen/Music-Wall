{
  "name": "music-wall",
  "version": "1.2.0",
  "description": "Obsidian 音乐墙插件（网易云专辑 · 唱片墙可视化）",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "sync": "node tools/deploy.cjs"
  },
  "keywords": [
    "obsidian",
    "music",
    "netease"
  ],
  "author": "Jason",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "qrcode-generator": "2.0.4"
  }
}
